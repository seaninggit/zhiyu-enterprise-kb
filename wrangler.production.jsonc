{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhiyu-enterprise-kb-prod",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": { "directory": "dist/client" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhiyu-kb-prod",
      "database_id": "e8ecf08a-f694-49a5-b8b4-91a75ea3f491"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KNOWLEDGE_FILES",
      "id": "e6bdfa83beff41a7adae2e81c98327e7"
    }
  ],
  "observability": { "enabled": true }
  ,"routes": [
    { "pattern": "zhiyu-kb.xyz", "custom_domain": true },
    { "pattern": "www.zhiyu-kb.xyz", "custom_domain": true }
  ]
  ,"triggers": { "crons": ["0 18 * * *"] }
}
